{
  "name": "meti-chartuloba-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:report": "node scripts/contrast-report.mjs",
    "i18n:stub": "node scripts/i18n-stub.mjs && prettier --write src/i18n/en.js",
    "placeholders": "node scripts/placeholders.mjs",
    "audit": "python3 scripts/audit.py --out audit.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "@fontsource/noto-serif-georgian": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "~5.0.4",
    "vitest-axe": "^0.1.0"
  }
}
