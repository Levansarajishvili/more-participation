# „მეტი ჩართულობა“ — API-ის env (B1–B5). ასლი: `cp server/.env.example server/.env` (.env git-სა და
# zip-ში არ ხვდება). ნამდვილი მნიშვნელობა მხოლოდ .env-ში ან ჰოსტინგის (Render) env-ში.
# წესები და შემოწმება — server/config.js (ENV_SCHEMA); არასწორი მნიშვნელობა → გაშვება ჩერდება.

# development | test | production
NODE_ENV=development

# ცარიელი → development: 127.0.0.1, production: 0.0.0.0 (Render / Fly კონტეინერი)
HOST=
# Render თავად აყენებს PORT-ს (10000)
PORT=3000

# fatal | error | warn | info | debug | trace | silent (test — silent)
LOG_LEVEL=info

# proxy-ის რაოდენობა კლიენტამდე: 0 — ლოკალური, 1 — Render, 2 — Render + Cloudflare (B7)
TRUST_PROXY=0

# JSON-ის სხეულის ზღვარი, ბაიტი (ფაილის ატვირთვა — MEDIA_MAX_*, B5)
BODY_LIMIT=1048576

# MongoDB Atlas (AWS eu-central-1). ცარიელი → development-ში დროებითი in-memory replica set;
# production-ში სავალდებულოა. მომხმარებელი — readWrite მხოლოდ ერთ ბაზაზე.
MONGODB_URI=
# MONGODB_URI=mongodb+srv://[მომხმარებელი]:[პაროლი]@[კლასტერი].mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=meti-chartuloba

# შენახვის ვადები (B0 #10 — ნაგულისხმევი, დასადასტურებელი კონფიდენციალურობის პოლიტიკასთან).
# კონტაქტის შეტყობინება (TTL, დღე) — ცვლილების შემდეგ: npm run server:migrate
MESSAGES_TTL_DAYS=30
# ვერსიები თითო მასალაზე (ძველი ტრანზაქციაში იშლება)
VERSIONS_KEEP=30

# ─── B3: სესია, მოწვევა, rate limit ────────────────────────────────────────
# B0 #10-ის ნაგულისხმევი (დასადასტურებელი კონფიდენციალურობის პოლიტიკასთან):
# სესია — უმოქმედობა (წუთი, 5–720) და აბსოლუტური მაქსიმუმი (საათი, 1–24); უმოქმედობა ≤ მაქსიმუმი
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# მოწვევის ვადა (დღე, 1–30)
INVITE_TTL_DAYS=7
# rate limit: [N] მცდელობა / [ვადა] წამებში (ნაგულისხმევი — დასადასტურებელი).
# auth — შესვლა და რეგისტრაცია: IP ყოველ მცდელობაზე; შესვლაზე + ელფოსტა წარუმატებელზე
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
# forms — საჯარო ფორმები (B6: კონტაქტი, გამოწერა), IP-ით
RATE_LIMIT_FORMS_MAX=10
RATE_LIMIT_FORMS_WINDOW_SECONDS=600

# ─── პირველი ადმინისტრატორი (B3) ──────────────────────────────────────────
# `npm run server:create-admin` — ცარიელზე ტერმინალში იკითხავს (პაროლი არ ჩანს). dev-ში
# MONGODB_URI-ის გარეშე (in-memory ბაზა) — თუ შევსებულია, `server:dev` ადმინისტრატორს თავად ქმნის.
# ნაგულისხმევი პაროლი არ არსებობს. პაროლი ამ ფაილში არ შეინახო — გაშვების შემდეგ წაშალე.
# ADMIN_EMAIL=[ელფოსტა]
# ADMIN_NAME=[სახელი გვარი]
# ADMIN_PASSWORD=[პაროლი — მინიმუმ 12 სიმბოლო]

# ─── B5: ფაილები (ფოტო, PDF, სუბტიტრის VTT) ───────────────────────────────
# საცავი: r2 | local | memory. ცარიელი → production: r2 (სავალდებულო — Render-ის დისკი deploy-ზე
# იშლება), development: local (MEDIA_DIR, ნაგულისხმევი server/.media/), test: memory.
MEDIA_STORAGE=
# MEDIA_DIR=[საქაღალდე — მხოლოდ local]
# Cloudflare R2 (S3 API, SigV4): https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com/<R2_BUCKET>.
# R2_ENDPOINT — სხვა S3-თავსებადი მისამართი (MinIO, ტესტი) R2_ACCOUNT_ID-ის ნაცვლად.
# გასაღებს მხოლოდ ამ bucket-ზე Object Read & Write უფლება — B7.
# R2_ACCOUNT_ID=[ანგარიშის id — 32 hex]
# R2_ENDPOINT=[https://…]
# R2_BUCKET=[bucket]
# R2_ACCESS_KEY_ID=[გასაღები]
# R2_SECRET_ACCESS_KEY=[საიდუმლო]
# ატვირთვის ზღვრები — [MB] (ნაგულისხმევი, დასადასტურებელი); VTT — 1 MB (უცვლელი)
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_DOCUMENT_MB=20
# სურათის მეგაპიქსელები (სერვერის მეხსიერება: 40 MP ≈ 120 MB გაშლილი)
MEDIA_MAX_MEGAPIXELS=40

# ─── შემდეგი ნაბიჯები (ჯერ არ იკითხება) ───────────────────────────────────
# B6: კონტაქტის ფორმის მიმღები (B0 #8)
# CONTACT_INBOX=[ელფოსტა]
# B6 / B7: Resend — გამგზავნი no-reply@[დომენი]
# RESEND_API_KEY=[გასაღები]
# B7: R2-ის custom domain / CDN (არასავალდებულო; ახლა ფაილებს `/media/*` Fastify აწვდის)
# MEDIA_BASE_URL=[https://…]
# ტესტი: mongodb-memory-server-ის binary-ის ვერსია (ნაგულისხმევი 8.0.34)
# MONGOMS_VERSION=8.0.34
